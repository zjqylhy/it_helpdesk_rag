doc-fetch-resources/

# 本地运行与构建输出
node_modules/
dist/
.venv/
.venv*/
__pycache__/
*.pyc
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/

# 部署者提供的网关证书不进入源码。
deploy/certs/*

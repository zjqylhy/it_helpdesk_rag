# 图表校验绑定原始字节，避免 Windows 换行转换破坏 SHA256。
.archify/** -text whitespace=cr-at-eol
# 保留生成器输出中的空白，避免手工修改已验证 HTML。
.archify/**/*.html whitespace=cr-at-eol,-blank-at-eol
# 架构规格的图源和渲染产物按原始字节校验。
docs/redesign/diagrams/** -text whitespace=cr-at-eol
# 迁移校验和绑定 SQL 字节，跨平台检出统一使用 LF。
rewrite/db/migrations/*.sql text eol=lf
rewrite/backend/tests/fixtures/*.sql text eol=lf

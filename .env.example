DATABASE_URL=postgresql://rag:rag@localhost:5432/rag?sslmode=disable
POSTGRES_PASSWORD=rag
# Docker 构建下载主机；默认 PyPI，可按网络情况改为 pypi.tuna.tsinghua.edu.cn。
PYPI_DOWNLOAD_HOST=files.pythonhosted.org
UV_BUILD_INDEX=https://pypi.org/simple
HTTP_ADDR=127.0.0.1:8080
RAG_URL=http://127.0.0.1:8000
INTERNAL_TOKEN=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
USER_NAME=demo
USER_PASSWORD=replace-with-another-password
UPLOAD_DIR=./data/uploads
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-pro
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com

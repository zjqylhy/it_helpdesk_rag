EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
RERANK_MODEL=qwen3.7-text-rerank
# 开启后仅使用应用 Key 调用网关；实际模型名保留用于旧向量兼容校验。
CHAT_GATEWAY_ENABLED=false
RETRIEVAL_GATEWAY_ENABLED=false
MODEL_GATEWAY_BASE_URL=https://localhost:9443/v1
IT_HELPDESK_RAG_API_KEY=
GATEWAY_CHAT_MODEL=chat
GATEWAY_EMBEDDING_MODEL=embedding
GATEWAY_RERANK_MODEL=rerank
MODEL_GATEWAY_CA_FILE=

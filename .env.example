# 在线配置：由 tools/windows.ps1 -Action Init 创建 .env.python，保留历史 .env。
POSTGRES_USER=helpdesk
POSTGRES_DB=helpdesk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=55534
WEB_PORT=3000
APP_REVISION=local
# 原生运行使用此连接；Compose 自动改用内部 db 地址。
HD_DATABASE_URL=postgresql://helpdesk:CHANGE_ME@127.0.0.1:55534/helpdesk
HD_UPLOAD_DIR=./data/python-uploads
HD_HOST=127.0.0.1
HD_PORT=18080
HD_API_TARGET=http://127.0.0.1:18080
# 填写端点、实际模型身份及密钥后显式启用推理。
HD_MODEL_INFERENCE_ENABLED=false
HD_CHAT_URL=
HD_CHAT_MODEL=
HD_CHAT_REQUEST_MODEL=
HD_EMBEDDING_URL=
HD_EMBEDDING_MODEL=
HD_EMBEDDING_REQUEST_MODEL=
HD_EMBEDDING_DIMENSION=1024
HD_RERANK_URL=
HD_RERANK_MODEL=
HD_RERANK_REQUEST_MODEL=
HD_RERANK_FORMAT=qwen
HD_MODEL_API_KEY=
HD_CHAT_API_KEY=
HD_EMBEDDING_API_KEY=
HD_RERANK_API_KEY=
# 容器使用 /run/certs/文件名；原生运行使用本机绝对路径。
HD_MODEL_CA_FILE=
HD_MODEL_CONNECT_HOST=
HD_REQUEST_TIMEOUT=110
HD_REQUEST_CALLS=24
HD_TOKEN_RESERVATION_LIMIT=48000
HD_WORKER_LEASE_SECONDS=90
HD_WORKER_HEARTBEAT_SECONDS=20
HD_WORKER_JOB_TIMEOUT=600
